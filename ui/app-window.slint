import { Button, VerticalBox, GridBox, Slider } from "std-widgets.slint";
import { MySlider } from "MySlider.slint";
import { HumidityPage } from "HumidityPage.slint";
import { Button, VerticalBox, GridBox, Slider } from "std-widgets.slint";

export component AppWindow inherits Window {
    property <int> temperature: 20;
    property <string> humidity_info: "medium"; // Tracks the current humidity level
    property <string> current_page: "temperature"; // Tracks the current page

    width: 1024px;
    height: 600px;
    background: #141218;

    VerticalBox {
        alignment: LayoutAlignment.stretch;
        spacing: 0px;
        padding: 24px;

        // Header
        Text {
            text: "Hello, Mateusz!";
            font-size: 32px;
            color: #ffffff;
        }

        HorizontalLayout {
            height: 80%;

            // Left Side: Buttons Grid
            GridBox {
                spacing: 8px; // Add spacing between buttons
                Button {
                    width: 100%;
                    height: 100%;
                    checkable: true;
                    text: "Temperature: " + temperature + "°C";
                    row: 0;
                    col: 0;
                    checked: current_page == "temperature"; // Bind checked state to current_page
                    clicked => {
                        current_page = "temperature";
                    }
                }

                Button {
                    width: 100%;
                    height: 100%;
                    checkable: true;
                    text: "Humidity: " + humidity_info;
                    row: 0;
                    col: 1;
                    checked: current_page == "humidity"; // Bind checked state to current_page
                    clicked => {
                        current_page = "humidity";
                    }
                }

                Button {
                    width: 100%;
                    height: 100%;
                    checkable: true;
                    text: "Power consumption: 25.0kW/h";
                    row: 1;
                    col: 0;
                    checked: current_page == "power"; // Bind checked state to current_page
                    clicked => {
                        current_page = "power";
                    }
                }

                Button {
                    width: 100%;
                    height: 100%;
                    checkable: true;
                    text: "Air quality: good";
                    row: 1;
                    col: 1;
                    checked: current_page == "air_quality"; // Bind checked state to current_page
                    clicked => {
                        current_page = "air_quality";
                    }
                }
            }

            // Side Panel
            sidePanel := Rectangle {
                width: 50%;
                background: #2c2c2c;
                padding: 16px;

                // Temperature Page
                Rectangle {
                    visible: current_page == "temperature";
                    Slider {
                        orientation: Orientation.vertical;
                        height: 100%;
                        width: 10%;
                        minimum: 0;
                        maximum: 30;
                        value: temperature;

                        changed(value) => {
                            temperature = value;
                        }
                    }

                    Text {
                        text: round(temperature) + "°C";
                        font-size: 24px;
                        color: #ffffff;
                    }
                }

                // Humidity Page
                Rectangle {
                    visible: current_page == "humidity";
                    VerticalBox {
                        spacing: 8px; // Add spacing between buttons
                        Button {
                            text: "High";
                            checkable: true;
                            checked: humidity_info == "high"; // Bind checked state to humidity_info
                            clicked => {
                                humidity_info = "high";
                            }
                        }
                        Button {
                            text: "Medium";
                            checkable: true;
                            checked: humidity_info == "medium"; // Bind checked state to humidity_info
                            clicked => {
                                humidity_info = "medium";
                            }
                        }
                        Button {
                            text: "Low";
                            checkable: true;
                            checked: humidity_info == "low"; // Bind checked state to humidity_info
                            clicked => {
                                humidity_info = "low";
                            }
                        }
                    }
                }

                // Power Consumption Page
                Rectangle {
                    visible: current_page == "power";
                }

                // Air Quality Page
                Rectangle {
                    visible: current_page == "air_quality";
                    Text {
                        text: "Air Quality: good";
                        font-size: 24px;
                        color: #ffffff;
                    }
                }
            }
        }
    }
}